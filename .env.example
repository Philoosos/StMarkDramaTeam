# Copy to .env for local development. Never put real credentials in Git.
# PostgreSQL connection for the local database.
DATABASE_URL="postgresql://postgres:local_dev_only_change_me@127.0.0.1:5433/markramus_ticketing?schema=public"
POSTGRES_PASSWORD="local_dev_only_change_me"

# Replace with a private random value before first login/setup; never commit .env.
AUTH_HASH_SECRET="replace-this-with-a-private-random-secret-at-least-32-bytes"

# Public application origin used for absolute links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


